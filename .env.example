# ── chat-ledger environment variables ────────────────────────────────────────
# Copy this file to .env, fill in the placeholders, and keep .env out of git.
# Never commit real secrets to the repository.
# Requirement: 9.4 (secrets from environment variables only).

# PostgreSQL (used by Docker Compose and the application)
POSTGRES_DB=chatledger
POSTGRES_USER=<replace-with-db-user>
POSTGRES_PASSWORD=<replace-with-strong-password>

# Spring Boot datasource (must match the values above)
DB_URL=jdbc:postgresql://localhost:5432/chatledger
DB_USER=<replace-with-db-user>
DB_PASSWORD=<replace-with-strong-password>

# Application session / HMAC secret (generate with: openssl rand -hex 32)
APP_SECRET=<replace-with-random-hex-secret>
