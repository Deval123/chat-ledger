# ── chat-ledger environment variables ────────────────────────────────────────
# Copy this file to .env, fill in every placeholder, and keep .env out of git.
# Never commit real secrets to the repository.
# Requirement: 9.4 (secrets from environment variables only).

# ── Bootstrap superuser (Docker / cluster init only) ─────────────────────────
#
# POSTGRES_USER is the superuser that the PostgreSQL Docker image creates.
# It is used only during cluster initialisation (docker-entrypoint-initdb.d)
# and must NEVER be given to the application or to Flyway.
#
POSTGRES_DB=chatledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<replace-with-strong-superuser-password>

# ── Migration role (Flyway only) ──────────────────────────────────────────────
#
# MIGRATE_USER is a non-superuser login role created by the Docker init script
# (docker/initdb/01_create_roles.sh).  It owns the schema and is the only role
# that runs Flyway migrations.  It must not be used by the application at runtime.
#
MIGRATE_USER=chatledger_migrate
MIGRATE_PASSWORD=<replace-with-strong-migrate-password>

# Flyway connects as MIGRATE_USER to run migrations.
# spring.flyway.user and spring.flyway.password read these values.
FLYWAY_USER=chatledger_migrate
FLYWAY_PASSWORD=<same-as-MIGRATE_PASSWORD>

# ── Application role (runtime) ────────────────────────────────────────────────
#
# APP_LOGIN_USER is a login role created by the Docker init script.
# The init script makes this role a member of chatledger_app (INHERIT). After
# Flyway runs V008 it has INSERT + SELECT on the ledger tables and no DDL rights.
#
APP_LOGIN_USER=chatledger_app_login
APP_LOGIN_PASSWORD=<replace-with-strong-app-password>

# Spring Boot datasource connects as APP_LOGIN_USER.
DB_URL=jdbc:postgresql://localhost:5432/chatledger
DB_USER=chatledger_app_login
DB_PASSWORD=<same-as-APP_LOGIN_PASSWORD>

# ── Application session / HMAC secret ───────────────────────────────────────
# Generate with: openssl rand -hex 32
APP_SECRET=<replace-with-random-hex-secret>
