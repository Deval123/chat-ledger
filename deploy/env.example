# deploy/env.example: copy to /opt/chat-ledger/.env (root:root 0640). Non-secret settings only; Compose reads this file for the
# ${...} values of compose.yaml. Secrets are files under /opt/chat-ledger/secrets/ (make-secrets.sh), never here.
#
# Keep the previous file as .env.<date> before each change: it is the rollback (RUNBOOK.md, "Roll back").

# The release to run: the sha256 digest printed by CI's image-push job (its summary), for ghcr.io/deval123/chat-ledger.
# A tag is not accepted: compose.yaml writes the image as ghcr.io/deval123/chat-ledger@<this value>.
CHAT_LEDGER_DIGEST=sha256:<replace-with-the-64-hex-digest-from-the-image-push-job>

# How many X-Forwarded-For entries the tunnel path appends. 0 (the header is ignored) until measured (RUNBOOK.md, "Measure the hops").
APP_SECURITY_TRUSTED_PROXY_HOPS=0

# Demo workspaces kept ready by the refresh loop (task 9). demo-refresh accepts 10 to 50; the memory and disk plan assumes 30.
DEMO_POOL=30
