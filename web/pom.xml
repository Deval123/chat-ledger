<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.chatledger</groupId>
    <artifactId>chat-ledger</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>web</artifactId>
  <name>web</name>
  <description>
    Board UI, simulators, CSV export, authentication, and session management.
    Thymeleaf + HTMX; depends on all other modules.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.chatledger</groupId>
      <artifactId>ledger-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chatledger</groupId>
      <artifactId>extraction</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chatledger</groupId>
      <artifactId>ingestion</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chatledger</groupId>
      <artifactId>matching</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chatledger</groupId>
      <artifactId>suspicion</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chatledger</groupId>
      <artifactId>demo</artifactId>
    </dependency>

    <!--
      spring-boot-starter-web is deprecated in Boot 4.1.1 in favour of
      spring-boot-starter-webmvc (Spring MVC) or spring-boot-starter-webflux.
      We use the explicit MVC starter here.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <!--
      Spring Boot 4 moved Flyway auto-configuration out of flyway-core into
      spring-boot-starter-flyway. With flyway-core alone, no migration runs on
      startup. flyway-database-postgresql is still needed for PostgreSQL.
      (Spring Boot docs: How-to > Database Initialization > Flyway.)
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Argon2id password hashing (Spring Security's Argon2PasswordEncoder needs BouncyCastle) -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <!-- Bounded cache for the in-memory rate limiter (version managed by the Boot BOM) -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!--
      thymeleaf-extras-springsecurity6 is still the correct artifact ID
      in Boot 4.1.1 (version 3.1.5.RELEASE, managed by the Boot BOM).
    -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Reuses the ledger-core scenario runner and generators for the PostgreSQL property. -->
    <dependency>
      <groupId>dev.chatledger</groupId>
      <artifactId>ledger-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- The hostile-input corpus, thrown at the ingestion service too. -->
    <dependency>
      <groupId>dev.chatledger</groupId>
      <artifactId>extraction</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      spring-boot-starter-webmvc-test provides @AutoConfigureMockMvc (which moved to
      org.springframework.boot.webmvc.test.autoconfigure in Boot 4.x) and the
      MockMvc autoconfiguration that was bundled in spring-boot-test-autoconfigure
      in Boot 3.x.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Testcontainers 2.x renamed all module artifacts.
      Old (1.x): org.testcontainers:postgresql / junit-jupiter
      New (2.x): org.testcontainers:testcontainers-postgresql / testcontainers-junit-jupiter
      Versions are managed by the testcontainers-bom 2.0.5 imported in the root POM.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The runnable JAR lives in the web module -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        Runs *IT classes (Testcontainers) in the verify phase. Version and
        executions come from the Spring Boot parent. Requires Docker.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
