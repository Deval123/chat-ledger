<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ── Coordinates ─────────────────────────────────────────────── -->
  <groupId>dev.chatledger</groupId>
  <artifactId>chat-ledger</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>chat-ledger</name>
  <description>Match WhatsApp orders to mobile-money payments with a double-entry ledger.</description>

  <modules>
    <module>ledger-core</module>
    <module>extraction</module>
    <module>ingestion</module>
    <module>matching</module>
    <module>suspicion</module>
    <module>demo</module>
    <module>web</module>
  </modules>

  <!-- ── BOM: Spring Boot 4.1.1 drives transitive versions ──────────
       Confirmed on Maven Central 2026-08-21.
       Spring Framework 7.0.9 / Spring Security 7.1.1 / Jakarta EE 11.
       Java 21 is supported (Boot 4 baseline is Java 17+).
  ─────────────────────────────────────────────────────────────────── -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <!-- ── Global properties ─────────────────────────────────────────── -->
  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- ── Dependency versions (all pinned) ──────────────────────────
         Versions managed by the Boot 4.1.1 BOM do not need to be listed
         here; they are overridden only where we consciously deviate.

         Boot 4.1.1 BOM provides:
           assertj        3.27.7
           testcontainers 2.0.5
           flyway         12.4.0
           postgresql     42.7.13
           jqwik          (not in BOM — managed below)
    ─────────────────────────────────────────────────────────────────── -->

    <!--
      jqwik 1.9.3 — last stable release in the 1.9 line (2025-06-07).
      The 1.10.x line shipped an intentional prompt-injection payload in
      test output (https://github.com/jlink/jqwik/releases) and is not
      used here. Keep this exact version. Boot 4.1.1 ships JUnit Jupiter 6
      (not 5.11, as an earlier version of this comment wrongly said); the
      jqwik 1.9.3 engine was checked to run on it (task 2.2).
    -->
    <jqwik.version>1.9.3</jqwik.version>
    <tomcat.version>11.0.27</tomcat.version>

    <!--
      BouncyCastle provider: Spring Security's Argon2PasswordEncoder needs it (the only reason it is here).
      Not managed by the Boot BOM, so pinned here. 1.86 was the newest release on Maven Central when this
      was added (task 3.4); advisories were checked and are listed in docs/kiro-notes.md.
    -->
    <bouncycastle.version>1.86</bouncycastle.version>

    <!-- plugin versions — pinned explicitly, matching Boot BOM values -->
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <owasp-dependency-check.version>10.0.4</owasp-dependency-check.version>
  </properties>

  <!-- ── Dependency management (pinned) ────────────────────────────── -->
  <dependencyManagement>
    <dependencies>
      <!-- Internal modules -->
      <dependency>
        <groupId>dev.chatledger</groupId>
        <artifactId>ledger-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Test support from ledger-core: in-memory repository, scenario runner, jqwik generators. -->
      <dependency>
        <groupId>dev.chatledger</groupId>
        <artifactId>ledger-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>dev.chatledger</groupId>
        <artifactId>extraction</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>dev.chatledger</groupId>
        <artifactId>extraction</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.chatledger</groupId>
        <artifactId>ingestion</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.chatledger</groupId>
        <artifactId>matching</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.chatledger</groupId>
        <artifactId>suspicion</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.chatledger</groupId>
        <artifactId>demo</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        Testcontainers BOM — version 2.0.5 managed by Boot 4.1.1.
        The Boot BOM imports testcontainers-bom itself, but Maven does not
        propagate nested BOM imports to child modules automatically. We
        re-import it here with the hardcoded version so that child modules
        can omit versions on individual org.testcontainers:* artifacts.
      -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- BouncyCastle provider for Argon2 (not in the Boot BOM) -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>

      <!-- jqwik (property-based testing) — not in Boot BOM -->
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>

      <!--
        postgresql and assertj versions come from the Boot 4.1.1 BOM
        (42.7.13 and 3.27.7 respectively). No override needed; listing
        them in dependencyManagement without a version would cause a build
        error, so they are simply removed and inherited from the BOM.
      -->
    </dependencies>
  </dependencyManagement>

  <!-- ── Dependencies shared by every module ───────────────────────── -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      assertj-core is already pulled in by spring-boot-starter-test.
      Listing it here separately (without a version) just makes the
      transitive dependency explicit for readers.
    -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- ── Build plugins ─────────────────────────────────────────────── -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>21</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- Required so jqwik engine and JUnit 5 both run -->
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${owasp-dependency-check.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- ── OWASP vulnerability check profile ────────────────────────── -->
  <!-- Run with: mvn -P security-check verify -->
  <profiles>
    <profile>
      <id>security-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>aggregate</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
            <configuration>
              <!-- Fail the build if any dependency has a CVSS score >= 7 -->
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <!-- API key read from the NVD_API_KEY environment variable.
                   Speeds up the NVD feed download and avoids rate-limiting.
                   Set the variable in CI secrets; leave it unset locally to
                   fall back to the unauthenticated (slower) download. -->
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
              <!-- Sonatype OSS Index needs credentials we do not use. Disabled to avoid
                   noisy errors; the NVD data remains the vulnerability source. -->
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <suppressionFiles>
                <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
